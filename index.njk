---
layout: layout
title: Posts
---

<p class="intro">Hi, I'm Peter. I write here about productivity, technology, personal development, and making things.</p>

<div class="eyebrow">Writing</div>

{%- for year, posts in collections.post | groupby('data.year') | dictsort | reverse -%}
    <section class="year-group">
        <h2 class="year-label">{{ year }}</h2>
        <ul class="post-list">
            {%- for post in posts | reverse -%}
                <li class="post-row">
                    <a href="{{ post.url }}">
                        <span class="title">{{ post.data.title }}</span>
                        <time class="date" datetime="{{ post.date }}">{{ post.date | date('d LLL') }}</time>
                    </a>
                </li>
            {%- endfor -%}
        </ul>
    </section>
{%- endfor -%}
