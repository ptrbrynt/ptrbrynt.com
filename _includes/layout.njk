---js 
{ now: new Date() }
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ title }} | Peter Bryant</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="/prism.css">
        <script src="/prism.js"></script>

        <link rel="alternate" type="application/rss+xml" href="https://ptrbrynt.com/feed.xml" title="Peter Bryant">

        <link rel="human-json" href="/human.json">

        <script>
            // Configure normalize-whitespace before Prism runs
            Prism
                .plugins
                .NormalizeWhitespace
                .setDefaults({
                    'remove-trailing': true, 'remove-indent': true, 'left-trim': true, 'right-trim': true, 'tabs-to-spaces': 2 // Dart convention — tightens indentation visually
                });
        </script>
        <link rel="stylesheet" href="/bundle.css">
    </head>
    <body>
        <header>
            <a {% if page.url == '/' %} aria-current="page" {% endif %} href="/">
                <h1>Peter Bryant</h1>
            </a>
            <nav aria-label="Main navigation">
                <ul>
                    {%- for pg in collections.page -%}
                        <li>
                            <a {% if page.url == pg.url %} aria-current="page" {% endif %} href={{ pg.url }}>{{ pg.data.title }}</a>
                        </li>
                    {%- endfor -%}
                </ul>
            </nav>
        </header>

        <main>
            {{ content | safe }}
            <br>
        </main>

        <footer>
            <nav aria-label="Footer navigation">
                <ul>
                    {%- for pg in collections['footer-page'] -%}
                        <li>
                            <a {% if page.url == pg.url %} aria-current="page" {% endif %} href={{ pg.url }}>
                                <small>{{ pg.data.title }}</small>
                            </a>
                        </li>
                    {%- endfor -%}
                </ul>

            </nav>
            <p>
                <small>
                        Copyright © Peter Bryant {{ now | date("yyyy") }}
                </small>
            </p>
        </footer>
    </body>
</html>